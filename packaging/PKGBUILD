# Maintainer: funkypitt <pierregallaz@gmail.com>
# Arch / Manjaro: cd packaging && makepkg -si
pkgname=readers-podcasts
pkgver=1.5.0
pkgrel=1
pkgdesc="Black-and-white, text-only podcast player: notes with live links, chapters, OPML, in step with the Android app"
arch=('any')
url="https://github.com/funkypitt/readers-podcasts-desktop"
license=('MIT')
depends=('python' 'python-pyqt5' 'qt5-multimedia' 'python-requests' 'gst-plugins-good')
optdepends=('gst-libav: m4a and aac episodes'
            'yt-dlp: the audio of YouTube channels'
            'python-faster-whisper: writing down what is said (or whisper.cpp, or openai-whisper)'
            'ffmpeg: needed by whisper.cpp and to tell the voices apart'
            'python-pyannote-audio: a paragraph at each change of voice'
            'ollama: translating what was written down')
source=("$pkgname-$pkgver.tar.gz::https://github.com/funkypitt/readers-podcasts-desktop/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/readers-podcasts-desktop-$pkgver"
  install -Dm755 readers_podcasts.py "$pkgdir/usr/lib/readers-podcasts/readers_podcasts.py"
  for f in packaging/fonts/*; do install -Dm644 "$f" "$pkgdir/usr/lib/readers-podcasts/fonts/$(basename "$f")"; done
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/readers-podcasts" <<'SH'
#!/bin/sh
exec python3 /usr/lib/readers-podcasts/readers_podcasts.py "$@"
SH
  install -Dm644 packaging/readers-podcasts.desktop "$pkgdir/usr/share/applications/readers-podcasts.desktop"
  install -Dm644 packaging/readers-podcasts.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/readers-podcasts.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
